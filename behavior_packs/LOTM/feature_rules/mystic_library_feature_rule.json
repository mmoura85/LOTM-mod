{
  "format_version": "1.21.0",
  "minecraft:feature_rules": {
    "description": {
      "identifier": "lotm:mystic_library_feature_rule",
      "places_feature": "lotm:mystic_library_feature"
    },
    "conditions": {
      "placement_pass": "surface_pass",
      "minecraft:biome_filter": {
        "any_of": [
          { "test": "has_biome_tag", "operator": "==", "value": "old_growth" },
          { "test": "has_biome_tag", "operator": "==", "value": "birch" },
          { "test": "has_biome_tag", "operator": "==", "value": "forest" },
          { "test": "has_biome_tag", "operator": "==", "value": "taiga" },
          { "test": "has_biome_tag", "operator": "==", "value": "jungle" },
          { "test": "has_biome_tag", "operator": "==", "value": "swamp" }
        ]
      }
    },
    "distribution": {
      "iterations": 1,
      "x": { "distribution": "uniform", "extent": [ 0, 16 ] },
      "y": "q.heightmap(v.worldx, v.worldz) - 1",
      "z": { "distribution": "uniform", "extent": [ 0, 16 ] },
      "scatter_chance": {
        "numerator": 1,
        "denominator": 600
      }
    }
  }
}
