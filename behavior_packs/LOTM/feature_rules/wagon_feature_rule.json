{
  "format_version": "1.21.0",
  "minecraft:feature_rules": {
    "description": {
      "identifier": "lotm:wagon_feature_rule",
      "places_feature": "lotm:wagon_feature"
    },
    "conditions": {
      "placement_pass": "surface_pass",
      "minecraft:biome_filter": {
        "any_of": [
          { "test": "has_biome_tag", "operator": "==", "value": "plains"  },
          { "test": "has_biome_tag", "operator": "==", "value": "meadow"  },
          { "test": "has_biome_tag", "operator": "==", "value": "savanna" },
          { "test": "has_biome_tag", "operator": "==", "value": "desert"  }
        ]
      }
    },
    "distribution": {
      "iterations": 1,
      "x": { "distribution": "uniform", "extent": [ 0, 16 ] },
      "y": "q.heightmap(v.worldx, v.worldz) - 1",
      "z": { "distribution": "uniform", "extent": [ 0, 16 ] },
      "scatter_chance": {
        "numerator": 1,
        "denominator": 300
      }
    }
  }
}
