{
    "format_version": "1.21.0",
    "minecraft:entity": {
        "description": {
            "identifier": "lotm:unicorn",
            "is_spawnable": false,
            "is_summonable": true,
            "is_experimental": false
        },
        "component_groups": {
            "lotm:untamed": {
                "minecraft:behavior.tempt": {
                    "priority": 3,
                    "speed_multiplier": 1.2,
                    "items": ["minecraft:golden_apple", "minecraft:enchanted_golden_apple", "minecraft:golden_carrot"],
                    "within_radius": 10
                },
                "minecraft:tameable": {
                    "probability": 0.25,
                    "tame_items": ["minecraft:golden_apple", "minecraft:enchanted_golden_apple", "minecraft:golden_carrot"],
                    "tame_event": { "event": "lotm:on_tame", "target": "self" }
                }
            },
            "lotm:tamed": {
                "minecraft:is_tamed": {},
                "minecraft:equippable": {
                    "slots": [
                        {
                            "slot": 0,
                            "item": "minecraft:saddle",
                            "accepted_items": ["minecraft:saddle"],
                            "on_equip":   { "event": "minecraft:on_saddled" },
                            "on_unequip": { "event": "minecraft:on_unsaddled" }
                        }
                    ]
                }
            },
            "lotm:saddled": {
                "minecraft:is_saddled": {}
            }
        },
        "components": {
            "minecraft:type_family": { "family": ["horse", "mob", "animal", "unicorn"] },
            "minecraft:physics": {},
            "minecraft:movement.basic": {},
            "minecraft:jump.static": {},
            "minecraft:input_ground_controlled": {},
            "minecraft:nameable": {},
            "minecraft:breathable": { "total_supply": 15, "suffocate_time": 0 },
            "minecraft:health": { "value": 120, "max": 120 },
            "minecraft:attack": { "damage": 9 },
            "minecraft:knockback_resistance": { "value": 0.3 },
            "minecraft:collision_box": { "width": 1.4, "height": 1.6 },
            "minecraft:movement": { "value": 0.35 },
            "minecraft:follow_range": { "value": 32, "max": 32 },
            "minecraft:navigation.walk": {
                "can_path_over_water": true,
                "avoid_damage_blocks": true
            },
            "minecraft:water_movement": { "drag_factor": 0.98 },
            "minecraft:inventory": { "inventory_size": 16, "container": "horse" },
            "minecraft:rideable": {
                "seat_count": 1,
                "family_types": ["player"],
                "controlling_seat": 0,
                "seats": [
                    {
                        "position": [0, 1.05, 0],
                        "min_rider_count": 0,
                        "max_rider_count": 1,
                        "rotate_rider_by": "query.body_y_rotation"
                    }
                ]
            },
            "minecraft:behavior.controlled_by_player": { "priority": 0 },
            "minecraft:behavior.float": { "priority": 1 },
            "minecraft:behavior.hurt_by_target": { "priority": 2 },
            "minecraft:behavior.melee_attack": {
                "priority": 3,
                "speed_multiplier": 1.5,
                "track_target": true,
                "require_complete_path": false
            },
            "minecraft:behavior.random_stroll": {
                "priority": 6,
                "speed_multiplier": 0.6,
                "xz_dist": 10,
                "y_dist": 2
            },
            "minecraft:behavior.look_at_player": { "priority": 7, "look_distance": 6, "probability": 0.02 },
            "minecraft:behavior.random_look_around": { "priority": 8 },
            "minecraft:loot": { "table": "loot_tables/entities/lotm/unicorn.json" },
            "minecraft:experience_reward": {
                "on_death": "query.last_hit_by_player ? Math.Random(5,10) : 0"
            },
            "minecraft:despawn": { "despawn_from_distance": { "max_distance": 128 } },
            "minecraft:pushable": { "is_pushable": true, "is_pushable_by_piston": true },
            "minecraft:hurt_on_condition": {
                "damage_conditions": [{
                    "filters": { "test": "in_lava", "subject": "self", "operator": "==", "value": true },
                    "cause": "lava",
                    "damage_per_tick": 4
                }]
            },
            "minecraft:conditional_bandwidth_optimization": {}
        },
        "events": {
            "minecraft:entity_spawned": {
                "add": { "component_groups": ["lotm:untamed"] }
            },
            "lotm:on_tame": {
                "remove": { "component_groups": ["lotm:untamed"] },
                "add":    { "component_groups": ["lotm:tamed"] }
            },
            "minecraft:on_saddled": {
                "add": { "component_groups": ["lotm:saddled"] }
            },
            "minecraft:on_unsaddled": {
                "remove": { "component_groups": ["lotm:saddled"] }
            }
        }
    }
}
