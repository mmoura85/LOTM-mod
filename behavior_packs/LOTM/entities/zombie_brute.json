{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "lotm:zombie_brute",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "lotm:roaring": {
        "minecraft:variant": { "value": 1 }
      },
      "lotm:not_roaring": {
        "minecraft:variant": { "value": 0 }
      }
    },
    "components": {
      "minecraft:type_family": { "family": ["zombie_brute", "undead", "monster", "mob"] },
      "minecraft:nameable": {},
      "minecraft:fire_immune": true,
      "minecraft:physics": {},
      "minecraft:pushable": { "is_pushable": false, "is_pushable_by_piston": true },
      "minecraft:collision_box": { "width": 1.2, "height": 2.7 },
      "minecraft:health": { "value": 75, "max": 75 },
      "minecraft:attack": { "damage": 11 },
      "minecraft:movement": { "value": 0.21 },
      "minecraft:knockback_resistance": { "value": 0.7 },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:breathable": { "total_supply": 15, "suffocate_time": 0 },
      "minecraft:follow_range": { "value": 40 },
      "minecraft:loot": { "table": "loot_tables/entities/lotm/zombie_brute.json" },
      "minecraft:experience_reward": { "on_death": "Math.Random(10, 20)" },
      "minecraft:despawn": { "despawn_from_distance": { "max_distance": 128 } },
      "minecraft:navigation.walk": {
        "can_path_over_water": false,
        "avoid_water": true,
        "can_open_doors": true,
        "can_break_doors": true,
        "avoid_damage_blocks": true
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": { "test": "in_lava", "subject": "self", "operator": "==", "value": true },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:damage_sensor": {
        "triggers": { "cause": "fall", "deals_damage": false }
      },
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:behavior.float": { "priority": 0 },
      "minecraft:behavior.hurt_by_target": { "priority": 1 },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 2,
        "within_radius": 22.0,
        "must_see": true,
        "entity_types": [
          { "filters": { "test": "is_family", "subject": "other", "value": "player" }, "max_dist": 22 },
          { "filters": { "test": "is_family", "subject": "other", "value": "decoy" }, "max_dist": 22 }
        ]
      },
      "minecraft:behavior.melee_attack": {
        "priority": 3,
        "track_target": true,
        "reach_multiplier": 1.3
      },
      "minecraft:behavior.move_towards_target": {
        "priority": 4,
        "speed_multiplier": 0.9,
        "within_radius": 28
      },
      "minecraft:behavior.random_stroll": { "priority": 6, "speed_multiplier": 0.6, "xz_dist": 10 },
      "minecraft:behavior.look_at_player": { "priority": 7, "look_distance": 8, "probability": 0.02 },
      "minecraft:behavior.random_look_around": { "priority": 8 }
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": { "component_groups": ["lotm:not_roaring"] }
      },
      "lotm:start_roar": {
        "add": { "component_groups": ["lotm:roaring"] },
        "remove": { "component_groups": ["lotm:not_roaring"] }
      },
      "lotm:end_roar": {
        "add": { "component_groups": ["lotm:not_roaring"] },
        "remove": { "component_groups": ["lotm:roaring"] }
      }
    }
  }
}
