{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "lotm:shade",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "lotm:stay": {
        "minecraft:behavior.stay_while_sitting": {
          "priority": 2
        }
      },
      "lotm:follow": {
        "minecraft:behavior.follow_owner": {
          "priority": 4,
          "speed_multiplier": 1.2,
          "start_distance": 10,
          "stop_distance": 3,
          "can_teleport": true,
          "ignore_vibration": true
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": ["shade", "undead", "mob", "lotm_ghost"]
      },

      "minecraft:tameable": {
        "probability": 1.0,
        "tame_items": [],
        "tame_event": {
          "event": "lotm:on_tamed",
          "target": "self"
        }
      },
      "minecraft:owner_identifier": {},
      "minecraft:is_tamed": {},

      "minecraft:can_fly": {},
      "minecraft:movement": { "value": 0.35 },
      "minecraft:flying_speed": { "value": 0.18 },
      "minecraft:navigation.hover": {
        "can_path_over_water": true,
        "can_sink": false,
        "can_path_from_air": true,
        "avoid_water": false,
        "avoid_damage_blocks": false,
        "avoid_sun": false
      },
      "minecraft:movement.hover": {},
      "minecraft:movement.float": {},
      "minecraft:physics": {
        "has_collision": true,
        "has_gravity": false
      },
      "minecraft:pushable": { "is_pushable": false },

      "minecraft:health": { "value": 30, "max": 30 },
      "minecraft:attack": { "damage": 6 },
      "minecraft:collision_box": { "width": 0.6, "height": 0.9 },

      "minecraft:loot": {
        "table": "loot_tables/entities/lotm/shade.json"
      },
      "minecraft:experience_reward": { "on_death": "0" },
      "minecraft:despawn": {
        "despawn_from_distance": { "max_distance": 64 }
      },

      "minecraft:behavior.float": { "priority": 0 },

      "minecraft:behavior.hurt_by_target": {
        "priority": 1,
        "entity_types": [
          {
            "filters": {
              "test": "is_family",
              "subject": "other",
              "operator": "!=",
              "value": "player"
            }
          }
        ]
      },

      "minecraft:behavior.owner_hurt_by_target": { "priority": 2 },
      "minecraft:behavior.owner_hurt_target":    { "priority": 3 },

      "minecraft:behavior.melee_attack": {
        "priority": 5,
        "speed_multiplier": 1.3,
        "track_target": true,
        "require_complete_path": false
      },

      "minecraft:behavior.nearest_attackable_target": {
        "priority": 6,
        "within_radius": 16.0,
        "must_see": false,
        "reselect_targets": true,
        "entity_types": [
          {
            "filters": {
              "all_of": [
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "monster"
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "operator": "!=",
                  "value": "lotm_ghost"
                }
              ]
            },
            "max_dist": 16
          }
        ]
      },

      "minecraft:behavior.random_look_around": { "priority": 9 }
    },

    "events": {
      "minecraft:entity_spawned": {
        "add": { "component_groups": ["lotm:follow"] }
      },
      "lotm:on_tamed": {
        "add": { "component_groups": ["lotm:follow"] }
      },
      "lotm:set_stay": {
        "remove": { "component_groups": ["lotm:follow"] },
        "add":    { "component_groups": ["lotm:stay"] }
      },
      "lotm:set_follow": {
        "remove": { "component_groups": ["lotm:stay"] },
        "add":    { "component_groups": ["lotm:follow"] }
      }
    }
  }
}
