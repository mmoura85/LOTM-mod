{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "lotm:earth_spirit_combat",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "lotm:despawn": {
        "minecraft:instant_despawn": {}
      }
    },
    "components": {
      "minecraft:type_family": { "family": ["earth_spirit", "spirit", "mob"] },
      "minecraft:nameable": {},
      "minecraft:fire_immune": true,
      "minecraft:physics": {},
      "minecraft:pushable": { "is_pushable": true, "is_pushable_by_piston": false },
      "minecraft:collision_box": { "width": 1.1, "height": 2.0 },
      "minecraft:health": { "value": 35, "max": 35 },
      "minecraft:attack": { "damage": 10 },
      "minecraft:movement": { "value": 0.28 },
      "minecraft:knockback_resistance": { "value": 0.4 },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:navigation.walk": {
        "can_path_over_water": false,
        "avoid_water": true,
        "avoid_damage_blocks": true
      },
      "minecraft:breathable": { "total_supply": 15, "suffocate_time": 0 },
      "minecraft:follow_range": { "value": 24, "max": 24 },
      "minecraft:despawn": { "despawn_from_distance": { "max_distance": 128 } },
      "minecraft:damage_sensor": {
        "triggers": [{ "cause": "all", "deals_damage": true }]
      },
      "minecraft:timer": {
        "looping": false,
        "time": [50, 50],
        "time_down_event": { "event": "lotm:despawn" }
      },
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:behavior.float": { "priority": 0 },
      "minecraft:behavior.hurt_by_target": {
        "priority": 1,
        "entity_types": [{
          "filters": { "test": "is_family", "subject": "other", "operator": "!=", "value": "player" }
        }]
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 2,
        "within_radius": 24.0,
        "must_see": false,
        "entity_types": [
          { "filters": { "test": "is_family", "subject": "other", "value": "monster" }, "max_dist": 24 },
          { "filters": { "test": "is_type", "subject": "other", "value": "lotm:rampager" }, "max_dist": 24 },
          { "filters": { "test": "is_type", "subject": "other", "value": "lotm:voidwatcher" }, "max_dist": 24 },
          { "filters": { "test": "is_type", "subject": "other", "value": "lotm:clown" }, "max_dist": 24 },
          { "filters": { "test": "is_type", "subject": "other", "value": "lotm:ghoul" }, "max_dist": 24 },
          { "filters": { "test": "is_type", "subject": "other", "value": "lotm:vengeful_ghost" }, "max_dist": 24 },
          { "filters": { "test": "is_type", "subject": "other", "value": "lotm:brownbear" }, "max_dist": 24 }
        ]
      },
      "minecraft:behavior.melee_attack": {
        "priority": 3,
        "speed_multiplier": 1.3,
        "track_target": true,
        "require_complete_path": false
      },
      "minecraft:behavior.random_stroll": { "priority": 6, "speed_multiplier": 0.5, "xz_dist": 6 },
      "minecraft:behavior.look_at_player": { "priority": 7, "look_distance": 8 },
      "minecraft:behavior.random_look_around": { "priority": 8 }
    },
    "events": {
      "lotm:despawn": {
        "add": { "component_groups": ["lotm:despawn"] }
      }
    }
  }
