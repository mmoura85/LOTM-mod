{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "lotm:clown",
      "runtime_identifier": "minecraft:zombie",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "lotm:clown_passive": {
        "minecraft:behavior.random_stroll": { "priority": 5, "speed_multiplier": 0.8 },
        "minecraft:behavior.random_look_around": { "priority": 7 },
        "minecraft:behavior.look_at_player": {
          "priority": 6, "look_distance": 8, "probability": 0.02
        }
      },
      "lotm:clown_hostile": {
        "minecraft:angry": {
          "duration": -1,
          "broadcast_anger": false,
          "calm_event": { "event": "lotm:clown_calm", "target": "self" }
        },
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 2,
          "within_radius": 20.0,
          "must_see": false,
          "entity_types": [
            {
              "filters": { "test": "is_family", "subject": "other", "value": "player" },
              "max_dist": 20
            },
            {
              "filters": { "test": "is_family", "subject": "other", "value": "monster" },
              "max_dist": 20
            }
          ]
        },
         "minecraft:behavior.melee_attack": {
          "priority": 4,
          "speed_multiplier": 1.3,
          "track_target": true,
          "require_complete_path": false,
          "cooldown_time": 0.5,
          "attack_once": false,
          "melee_fov": 90
        },
        "minecraft:behavior.random_stroll": { "priority": 8, "speed_multiplier": 0.9 }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": ["clown_beyonder", "monster", "mob"]
      },
      "minecraft:physics": {},
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:nameable": {},
      "minecraft:breathable": { "total_supply": 15, "suffocate_time": 0 },
      "minecraft:health": { "value": 30, "max": 30 },
      "minecraft:attack": { "damage": 5 },
      "minecraft:knockback_resistance": { "value": 0.1 },
      "minecraft:collision_box": { "width": 0.6, "height": 1.8 },
      "minecraft:movement": { "value": 0.32 },
      "minecraft:follow_range": { "value": 20 },
      "minecraft:navigation.walk": {
        "can_path_over_water": false,
        "avoid_damage_blocks": true
      },
      "minecraft:equipment": {
        "table": "loot_tables/entities/lotm/clown_equipment.json",
        "slot_drop_chance": [
          { "slot": "slot.weapon.mainhand", "drop_chance": 0.085 }
        ]
      },
      "minecraft:loot": { "table": "loot_tables/entities/lotm/clown.json" },
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? Math.Random(4,8) : 0"
      },
      "minecraft:despawn": { "despawn_from_distance": { "max_distance": 128 } },
      "minecraft:behavior.float": { "priority": 0 },
      "minecraft:behavior.hurt_by_target": {
        "priority": 1,
        "entity_types": [
          {
            "filters": {
              "any_of": [
                { "test": "is_family", "subject": "other", "value": "player" },
                { "test": "is_family", "subject": "other", "value": "monster" }
              ]
            }
          }
        ]
      },
      "minecraft:behavior.random_stroll": { "priority": 7, "speed_multiplier": 0.8 },
      "minecraft:behavior.random_look_around": { "priority": 9 },
      "minecraft:behavior.look_at_player": { "priority": 8, "look_distance": 8 },
      "minecraft:pushable": { "is_pushable": true, "is_pushable_by_piston": true },
      "minecraft:conditional_bandwidth_optimization": {}
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": { "component_groups": ["lotm:clown_passive"] }
      },
      "lotm:clown_aggro": {
        "remove": { "component_groups": ["lotm:clown_passive"] },
        "add": { "component_groups": ["lotm:clown_hostile"] }
      },
      "lotm:clown_calm": {
        "remove": { "component_groups": ["lotm:clown_hostile"] },
        "add": { "component_groups": ["lotm:clown_passive"] }
      }
    }
  }
}
