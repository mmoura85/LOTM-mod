{
  "format_version": "1.17.0",
  "minecraft:spawn_rules": {
    "description": {
      "identifier": "lotm:earth_spirit",
      "population_control": "animal"
    },
    "conditions": [
      {
        "minecraft:spawns_on_surface": {},
        "minecraft:brightness_filter": { "min": 7, "max": 15, "adjust_for_weather": true },
        "minecraft:difficulty_filter": { "min": "easy", "max": "hard" },
        "minecraft:weight": { "default": 5 },
        "minecraft:herd": { "min_size": 1, "max_size": 1 },
        "minecraft:biome_filter": {
          "any_of": [
            { "test": "has_biome_tag", "operator": "==", "value": "forest" },
            { "test": "has_biome_tag", "operator": "==", "value": "taiga" },
            { "test": "has_biome_tag", "operator": "==", "value": "old_growth" },
            { "test": "has_biome_tag", "operator": "==", "value": "birch" }
          ]
        }
      },
      {
        "minecraft:spawns_underground": {},
        "minecraft:brightness_filter": { "min": 0, "max": 7, "adjust_for_weather": true },
        "minecraft:difficulty_filter": { "min": "easy", "max": "hard" },
        "minecraft:weight": { "default": 5 },
        "minecraft:herd": { "min_size": 1, "max_size": 1 },
        "minecraft:biome_filter": {
          "test": "has_biome_tag", "operator": "!=", "value": "ocean"
        }
      }
    ]
  }
}
