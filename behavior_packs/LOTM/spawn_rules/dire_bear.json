{
    "format_version": "1.17.0",
    "minecraft:spawn_rules": {
        "description": {
            "identifier": "lotm:dire_bear",
            "population_control": "monster"
        },
        "conditions": [
            {
                "minecraft:spawns_on_surface": {},
                "minecraft:brightness_filter": {
                    "min": 7,
                    "max": 15,
                    "adjust_for_weather": true
                },
                "minecraft:difficulty_filter": {
                    "min": "normal",
                    "max": "hard"
                },
                "minecraft:weight": { "default": 3 },
                "minecraft:herd": { "min_size": 1, "max_size": 2 },
                "minecraft:biome_filter": {
                    "any_of": [
                        { "test": "has_biome_tag", "operator": "==", "value": "forest" },
                        { "test": "has_biome_tag", "operator": "==", "value": "birch" },
                        { "test": "has_biome_tag", "operator": "==", "value": "old_growth" },
                        { "test": "has_biome_tag", "operator": "==", "value": "jungle" }
                    ]
                }
            }
        ]
    }
}
