{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "lotm:shade",
      "materials": {
        "default": "vex"
      },
      "textures": {
        "default": "textures/entity/shade",
        "charging": "textures/entity/shade"
      },
      "geometry": {
        "default": "geometry.shade"
      },
      "scripts": {
        "pre_animation": [
          "variable.tcos0 = (Math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 57.3;"
        ],
        "scale": "0.4",
        "animate": [
          "vex_move",
          "look_at_target",
          { "attack.rotations": "variable.attack_time > 0.0" }
        ]
      },
      "animations": {
        "look_at_target": "animation.humanoid.look_at_target.default",
        "attack.rotations": "animation.shade.attack.rotations",
        "vex_move": "animation.shade.move"
      },
      "render_controllers": [ "controller.render.vex" ],
      "spawn_egg": {
        "base_color": "#0A0510",
        "overlay_color": "#AA0000"
      }
    }
  }
}
